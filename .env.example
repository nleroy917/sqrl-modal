# URL printed by `modal deploy serve.py`
SQRL_BASE_URL=https://your-workspace--sqrl-9b-inference-server.us-east.modal.direct

SNOWFLAKE_ACCOUNT=                   # e.g. abc12345.us-east-1
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=./snowflake-ai-key.p8   # PKCS#8 private key file (never commit)
#SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=   # blank if the key is unencrypted
SNOWFLAKE_ROLE=                      # use a read-only role
SNOWFLAKE_WAREHOUSE=

SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Optional: comma-separated allowlist, bare or fully-qualified (DB.SCHEMA.TABLE)
#SNOWFLAKE_TABLE=

# Optional: free-text domain hints injected into the model's prompt
#SQRL_EVIDENCE=

# Optional: set to 1 for verbose step-by-step logging
#SQRL_DEBUG=
